    withCheck = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    @@map("tenant_isolation")
  }

  policy_all tenant_isolation_entity {
    target    = Entity
    roles     = [public]
    using     = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    withCheck = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    @@map("tenant_isolation")
  }

  policy_all tenant_isolation_claim_version {
    target    = ClaimVersion
    roles     = [public]
    using     = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    withCheck = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    @@map("tenant_isolation")
  }

  policy_all tenant_isolation_claim_current {
    target    = ClaimCurrent
    roles     = [public]
    using     = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    withCheck = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    @@map("tenant_isolation")
  }

  policy_all tenant_isolation_claim_embedding {
    target    = ClaimEmbedding
    roles     = [public]
    using     = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    withCheck = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    @@map("tenant_isolation")
  }

  policy_all tenant_isolation_transcript_segment {
    target    = TranscriptSegment
    roles     = [public]
    using     = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    withCheck = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    @@map("tenant_isolation")
  }

  policy_all tenant_isolation_import_record {
    target    = ImportRecord
    roles     = [public]
    using     = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    withCheck = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    @@map("tenant_isolation")
  }
}
