// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Tenant {
    id               Uuid              @id(map: "tenant_pkey") @default(sql`uuidv7()`)
    name             String
    createdAt        Timestamptz       @default(now()) @map("created_at")
    campaigns        Campaign[]
    fieldDefinitions FieldDefinition[]
    importRecords    ImportRecord[]

    @@rls
    @@map("tenant")
  }

  model Campaign {
    tenantId           Uuid                @map("tenant_id")
    id                 Uuid                @default(sql`uuidv7()`)
    name               String
    claimCurrents      ClaimCurrent[]
    claimVersions      ClaimVersion[]
    claimVersionP0s    ClaimVersionP0[]
    claimVersionP1s    ClaimVersionP1[]
    claimVersionP2s    ClaimVersionP2[]
    claimVersionP3s    ClaimVersionP3[]
    entities           Entity[]
    fieldDefinitions   FieldDefinition[]
    transcriptSegments TranscriptSegment[]
    tenant             Tenant              @relation(fields: [tenantId], references: [id], map: "campaign_tenant_id_fkey", index: false)

    @@id([tenantId, id], map: "campaign_pkey")
    @@rls
    @@map("campaign")
  }

  model Entity {
    tenantId        Uuid             @map("tenant_id")
    id              Uuid             @default(sql`uuidv7()`)
    campaignId      Uuid             @map("campaign_id")
    kind            String
    name            String
    custom          Jsonb            @default(json`{}`)
    claimCurrents   ClaimCurrent[]
    claimVersions   ClaimVersion[]
    claimVersionP0s ClaimVersionP0[]
    claimVersionP1s ClaimVersionP1[]
    claimVersionP2s ClaimVersionP2[]
    claimVersionP3s ClaimVersionP3[]
    importRecords   ImportRecord[]
    campaign        Campaign         @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "entity_tenant_id_campaign_id_fkey")

    @@id([tenantId, id], map: "entity_pkey")
    @@index([tenantId, campaignId], map: "entity_campaign_idx")
    @@rls
    @@map("entity")
  }

  model ClaimCurrent {
    tenantId       Uuid            @map("tenant_id")
    claimId        Uuid            @map("claim_id")
    version        Int
    campaignId     Uuid            @map("campaign_id")
    subjectId      Uuid            @map("subject_id")
    predicate      String
    object         Jsonb
    claimEmbedding ClaimEmbedding?
    campaign       Campaign        @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "claim_current_tenant_id_campaign_id_fkey", index: false)
    entity         Entity          @relation(fields: [tenantId, subjectId], references: [tenantId, id], map: "claim_current_tenant_id_subject_id_fkey")

    @@id([tenantId, claimId], map: "claim_current_pkey")
    @@index([tenantId, subjectId], map: "claim_current_subject_idx")
    @@rls
    @@map("claim_current")
  }

  model ClaimEmbedding {
    tenantId     Uuid                        @map("tenant_id")
    claimId      Uuid                        @map("claim_id")
    embedding    Unsupported("halfvec(768)")
    claimCurrent ClaimCurrent                @relation(fields: [tenantId, claimId], references: [tenantId, claimId], onDelete: Cascade, map: "claim_embedding_tenant_id_claim_id_fkey")

    @@id([tenantId, claimId], map: "claim_embedding_pkey")
    @@index([embedding], map: "claim_embedding_hnsw", type: "hnsw", options: { ef_construction: "64", m: "16" })
    @@rls
    @@map("claim_embedding")
  }

  model ClaimVersion {
    tenantId   Uuid        @map("tenant_id")
    claimId    Uuid        @map("claim_id")
    version    Int
    campaignId Uuid        @map("campaign_id")
    subjectId  Uuid        @map("subject_id")
    predicate  String
    object     Jsonb
    recordedAt Timestamptz @default(now()) @map("recorded_at")
    campaign   Campaign    @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "claim_version_tenant_id_campaign_id_fkey", index: false)
    entity     Entity      @relation(fields: [tenantId, subjectId], references: [tenantId, id], map: "claim_version_tenant_id_subject_id_fkey", index: false)

    @@id([tenantId, claimId, version], map: "claim_version_pkey")
    @@check(expression: "(version > 0)", map: "claim_version_version_check")
    @@rls
    @@map("claim_version")
  }

  model ClaimVersionP0 {
    tenantId   Uuid        @map("tenant_id")
    claimId    Uuid        @map("claim_id")
    version    Int
    campaignId Uuid        @map("campaign_id")
    subjectId  Uuid        @map("subject_id")
    predicate  String
    object     Jsonb
    recordedAt Timestamptz @default(now()) @map("recorded_at")
    campaign   Campaign    @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "claim_version_tenant_id_campaign_id_fkey", index: false)
    entity     Entity      @relation(fields: [tenantId, subjectId], references: [tenantId, id], map: "claim_version_tenant_id_subject_id_fkey", index: false)

    @@id([tenantId, claimId, version], map: "claim_version_p0_pkey")
    @@map("claim_version_p0")
  }

  model ClaimVersionP1 {
    tenantId   Uuid        @map("tenant_id")
