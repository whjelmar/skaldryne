    recordedAt Timestamptz @default(now()) @map("recorded_at")
    campaign   Campaign    @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "claim_version_tenant_id_campaign_id_fkey", index: false)
    entity     Entity      @relation(fields: [tenantId, subjectId], references: [tenantId, id], map: "claim_version_tenant_id_subject_id_fkey", index: false)

    @@id([tenantId, claimId, version], map: "claim_version_p1_pkey")
    @@map("claim_version_p1")
  }

  model ClaimVersionP2 {
    tenantId   Uuid        @map("tenant_id")
    claimId    Uuid        @map("claim_id")
    version    Int
    campaignId Uuid        @map("campaign_id")
    subjectId  Uuid        @map("subject_id")
    predicate  String
    object     Jsonb
    recordedAt Timestamptz @default(now()) @map("recorded_at")
    campaign   Campaign    @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "claim_version_tenant_id_campaign_id_fkey", index: false)
    entity     Entity      @relation(fields: [tenantId, subjectId], references: [tenantId, id], map: "claim_version_tenant_id_subject_id_fkey", index: false)

    @@id([tenantId, claimId, version], map: "claim_version_p2_pkey")
    @@map("claim_version_p2")
  }

  model ClaimVersionP3 {
    tenantId   Uuid        @map("tenant_id")
    claimId    Uuid        @map("claim_id")
    version    Int
    campaignId Uuid        @map("campaign_id")
    subjectId  Uuid        @map("subject_id")
    predicate  String
    object     Jsonb
    recordedAt Timestamptz @default(now()) @map("recorded_at")
    campaign   Campaign    @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "claim_version_tenant_id_campaign_id_fkey", index: false)
    entity     Entity      @relation(fields: [tenantId, subjectId], references: [tenantId, id], map: "claim_version_tenant_id_subject_id_fkey", index: false)

    @@id([tenantId, claimId, version], map: "claim_version_p3_pkey")
    @@map("claim_version_p3")
  }

  model FieldDefinition {
    tenantId   Uuid      @map("tenant_id")
    id         Uuid      @default(sql`uuidv7()`)
    campaignId Uuid?     @map("campaign_id")
    key        String
    valueType  String    @map("value_type")
    campaign   Campaign? @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "field_definition_tenant_id_campaign_id_fkey", index: false)
    tenant     Tenant    @relation(fields: [tenantId], references: [id], map: "field_definition_tenant_id_fkey", index: false)

    @@id([tenantId, id], map: "field_definition_pkey")
    @@unique([tenantId, campaignId, key], map: "field_definition_tenant_id_campaign_id_key_key")
    @@check(expression: "(value_type = ANY (ARRAY['text'::text, 'number'::text, 'boolean'::text, 'date'::text]))", map: "field_definition_value_type_check")
    @@rls
    @@map("field_definition")
  }

  model ImportRecord {
    tenantId    Uuid        @map("tenant_id")
    source      String
    sourceKey   String      @map("source_key")
    entityId    Uuid        @map("entity_id")
    contentHash String      @map("content_hash")
    importedAt  Timestamptz @default(now()) @map("imported_at")
    entity      Entity      @relation(fields: [tenantId, entityId], references: [tenantId, id], map: "import_record_tenant_id_entity_id_fkey", index: false)
    tenant      Tenant      @relation(fields: [tenantId], references: [id], map: "import_record_tenant_id_fkey", index: false)

    @@id([tenantId, source, sourceKey], map: "import_record_pkey")
    @@rls
    @@map("import_record")
  }

  model TranscriptSegment {
    tenantId    Uuid     @map("tenant_id")
    id          Uuid     @default(sql`uuidv7()`)
    campaignId  Uuid     @map("campaign_id")
    sessionNo   Int      @map("session_no")
    startMs     Int      @map("start_ms")
    endMs       Int      @map("end_ms")
    speaker     String?
    text        String
    wordTimings Bytes    @map("word_timings")
    campaign    Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], map: "transcript_segment_tenant_id_campaign_id_fkey", index: false)

    @@id([tenantId, id], map: "transcript_segment_pkey")
    @@index([tenantId, campaignId, sessionNo, startMs], map: "transcript_segment_session_idx")
    @@check(expression: "(end_ms >= start_ms)", map: "transcript_segment_check")
    @@rls
    @@map("transcript_segment")
  }

  policy_all tenant_isolation {
    target = Campaign
    roles = [public]
    using = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    withCheck = "(tenant_id = (NULLIF(current_setting('app.tenant_id'::text, true), ''::text))::uuid)"
    @@map("tenant_isolation")
  }

